# ============================================================
# 复制为 .env 后按需修改（.env 不提交 Git）
#   cp .env.example .env
#   docker compose up --build -d
# ============================================================

# ---- MySQL ----
MYSQL_DATABASE=taskdb
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_ROOT_PASSWORD=rootpassword

# ---- JWT（生产务必改）----
JWT_SECRET=change-me-please-use-a-long-secret-2024!!

# ---- AI Provider（mock = 不调用真实模型；有 Key 改 openai）----
AI_PROVIDER=mock
# 阿里云百炼 API Key（AI_PROVIDER=openai 时必填）
DASHSCOPE_API_KEY=

# ---- MinIO（文件存储）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 对象存储根（backend 镜像内部固定 http://minio:9000，一般无需改）
MINIO_ENDPOINT=

# ---- 向量存储类型 ----
# qdrant：Qdrant（backend 内部固定连 qdrant:6333）
STORAGE_TYPE=minio
